# Copy to .env and adjust. .env is gitignored — NEVER commit real secrets.
# All values are optional; sane defaults are shown. Real environment variables
# always override this file.

# --- bind ---
# Leave DASH_HOST empty/omit for AUTO-DETECTION of this machine's Tailscale IP
# (run.py asks `tailscale ip -4`; falls back to 127.0.0.1 if unavailable).
# Hardcode only when needed:
# DASH_HOST=100.1.2.3
# DASH_HOST=127.0.0.1      # localhost only
# DASH_HOST=0.0.0.0        # all interfaces incl. LAN (only if LAN trusted)
DASH_PORT=8088

# --- polling / storage ---
DASH_POLL_SECONDS=30
# DASH_DATA_DIR=./data

# --- MCP hub (POST /mcp) ---
# When set, MCP clients MUST send: Authorization: Bearer <MCP_TOKEN>
# Generate one:  openssl rand -hex 32   (or any long random string)
MCP_TOKEN=

# --- AI Net containers used by MCP web tools ---
SEARXNG_URL=http://REPLACE-ME-searxng-host:8888
CRAWL4AI_URL=http://REPLACE-ME-crawl4ai-host:11235
CRAWL4AI_API_KEY=
